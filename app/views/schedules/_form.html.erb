<%= form_with(model: schedule, local: true) do |form| %>
  <% if schedule.errors.any? %>
    <div id="error_explanation">
      <h2><%= pluralize(schedule.errors.count, "error") %> prohibited this schedule from being saved:</h2>
      <ul>
        <% schedule.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="field">
    <%= form.label :title, 'タイトル' %><br>
    <%= form.text_field :title %>
  </div>

  <div class="field">
    <%= form.label :start_date, '開始日' %><br>
    <%= form.date_field :start_date %>
  </div>

  <div class="field">
    <%= form.label :end_date, '終了日' %><br>
    <%= form.date_field :end_date %>
  </div>

  <div class="field">
    <%= form.label :all_day, '終日' %><br>
    <%= form.check_box :all_day %>
  </div>

  <div class="field">
    <%= form.label :memo, 'メモ' %><br>
    <%= form.text_area :memo %>
  </div>

  <div class="actions">
    <%= form.submit %>
  </div>
<% end %>
