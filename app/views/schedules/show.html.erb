<h1 class="mb-4">スケジュール詳細</h1>

<table class="table table-bordered">
  <tbody>
    <tr>
      <th>タイトル</th>
      <td><%= @schedule.title %></td>
    </tr>
    <tr>
      <th>開始日</th>
      <td><%= @schedule.start_date.strftime('%Y/%m/%d') %></td>
    </tr>
    <tr>
      <th>終了日</th>
      <td><%= @schedule.end_date.strftime('%Y/%m/%d') %></td>
    </tr>
    <tr>
      <th>終日</th>
      <td><%= @schedule.all_day ? "◯" : "" %></td>
    </tr>
    <tr>
      <th>メモ</th>
      <td><%= simple_format(h(@schedule.memo)) %></td>
    </tr>
  </tbody>
</table>

<!-- 戻る / 編集ボタン -->
<div class="mt-3">
  <%= link_to '一覧に戻る', schedules_path, class: 'btn btn-secondary me-2' %>
  <%= link_to '編集', edit_schedule_path(@schedule), class: 'btn btn-success me-2' %>
</div>

